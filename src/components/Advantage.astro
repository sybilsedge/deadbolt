---
import { siteConfig } from '../config/site';
---

<section id="why-us" class="py-24 bg-slate-900 text-white relative overflow-hidden">
  <!-- Decorative Glow Circle -->
  <div class="absolute -top-32 -right-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Turnkey Advantage & 2x2 Feature Checklist Grid -->
      <div class="lg:col-span-7">
        <span class="inline-block bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">
          Why Hampton Roads Managers Trust Us
        </span>

        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight mb-6">
          THE TURNKEY <span class="gold-gradient-text">ADVANTAGE</span>
        </h2>

        <p class="text-slate-300 text-base sm:text-lg mb-10 leading-relaxed">
          We understand that every day a rental property sits vacant is lost revenue. Our dedicated crews streamline the turnover process, combining speed, precision, and reliable communication.
        </p>

        <!-- 2x2 Feature Checklist Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {siteConfig.advantageFeatures.map((feat) => (
            <div class="bg-slate-950/80 border border-slate-800 hover:border-amber-500/40 p-5 rounded-xl transition-all duration-300">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-7 h-7 rounded-full bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 shrink-0 font-bold text-sm">
                  ✓
                </div>
                <h3 class="font-heading font-bold text-lg text-white">
                  {feat.title}
                </h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-400 pl-10">
                {feat.description}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Owner Highlight Card (Navy Veteran) -->
      <div id="team" class="lg:col-span-5">
        <div class="relative">
          <!-- Background Glow Frame -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-br from-amber-500/30 via-slate-800 to-amber-700/20 blur-md"></div>

          <div class="relative bg-slate-950 border border-amber-500/30 rounded-2xl p-8 shadow-2xl text-center flex flex-col items-center">
            
            <!-- Veteran Badge Corner -->
            <div class="absolute top-4 right-4 bg-amber-500/10 text-amber-400 border border-amber-500/30 text-[10px] uppercase font-bold tracking-wider px-2.5 py-1 rounded-full flex items-center gap-1">
              <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
              </svg>
              Navy Veteran
            </div>

            <!-- Circle Avatar Container -->
            <div class="relative mb-6 mt-2">
              <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-full p-1 bg-gradient-to-tr from-amber-500 via-amber-400 to-amber-600 shadow-xl">
                <img 
                  src="/images/owner-avatar.png" 
                  alt={`${siteConfig.owner.name} - ${siteConfig.owner.title}`} 
                  class="w-full h-full object-cover rounded-full bg-slate-900"
                />
              </div>
              <div class="absolute -bottom-2 bg-slate-900 border border-amber-500 text-amber-400 p-1.5 rounded-full shadow-md">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
            </div>

            <!-- Owner Name & Subtitle -->
            <h3 class="font-heading font-extrabold text-2xl text-white mb-1">
              {siteConfig.owner.name}
            </h3>
            <div class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-4 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20">
              {siteConfig.owner.title}
            </div>

            <p class="text-sm text-slate-300 leading-relaxed italic mb-6">
              "{siteConfig.owner.bio}"
            </p>

            <!-- Direct Contact Button -->
            <a 
              href={`tel:${siteConfig.contact.phoneRaw}`}
              class="w-full bg-slate-900 hover:bg-slate-800 text-slate-200 hover:text-amber-400 border border-slate-700 font-semibold text-xs py-3 rounded-xl transition-colors flex items-center justify-center gap-2 uppercase tracking-wider"
            >
              <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Direct Owner Line: {siteConfig.contact.phone}
            </a>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
