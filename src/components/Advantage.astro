---
import { siteConfig } from '../config/site';
---

<section id="why-us" class="bg-gray-100 py-16 md:py-24 border-t border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-black text-brand-dark uppercase tracking-tight">
        THE DEAD BOLT ADVANTAGE
      </h2>
      <p class="text-gray-600 mt-2 max-w-2xl mx-auto">
        Dedicated field execution for asset managers, lenders, property managers, and realtors across Hampton Roads.
      </p>
      <div class="w-20 h-1.5 bg-amber-primary mx-auto mt-4"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm text-center">
        <div class="w-12 h-12 bg-amber-bg border border-amber-border text-amber-primary rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-xl">
          ✓
        </div>
        <h3 class="font-bold text-brand-dark uppercase mb-2">Licensed & Insured</h3>
        <p class="text-xs text-gray-600 leading-relaxed">
          Full liability coverage protecting lenders, asset managers, and realtors on every job site.
        </p>
      </div>

      <div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm text-center">
        <div class="w-12 h-12 bg-amber-bg border border-amber-border text-amber-primary rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-xl">
          📷
        </div>
        <h3 class="font-bold text-brand-dark uppercase mb-2">Fast Photo Reporting</h3>
        <p class="text-xs text-gray-600 leading-relaxed">
          Detailed before, during, and after job-site photo documentation delivered with every invoice.
        </p>
      </div>

      <div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm text-center">
        <div class="w-12 h-12 bg-amber-bg border border-amber-border text-amber-primary rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-xl">
          ⚖️
        </div>
        <h3 class="font-bold text-brand-dark uppercase mb-2">VA Code Compliance</h3>
        <p class="text-xs text-gray-600 leading-relaxed">
          Strict adherence to Virginia statutes for eviction property tagging, storage periods, and disposal.
        </p>
      </div>

      <div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm text-center">
        <div class="w-12 h-12 bg-amber-bg border border-amber-border text-amber-primary rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-xl">
          ⚡
        </div>
        <h3 class="font-bold text-brand-dark uppercase mb-2">24-48 Hr Lockout Response</h3>
        <p class="text-xs text-gray-600 leading-relaxed">
          Rapid crew mobilization to transition foreclosures and REO units to market-ready condition.
        </p>
      </div>
    </div>

    <!-- COVERAGE STRIP -->
    <div id="coverage" class="mt-16 bg-brand-dark text-white rounded-lg p-8 text-center shadow-lg border border-gray-800">
      <h3 class="text-2xl font-black uppercase tracking-tight text-white mb-2">HAMPTON ROADS REGIONAL COVERAGE</h3>
      <p class="text-gray-300 text-sm max-w-3xl mx-auto mb-4">
        Serving Virginia Beach, Norfolk, Chesapeake, Portsmouth, Newport News, Hampton, Suffolk, and Isle of Wight.
      </p>
      <div class="inline-block bg-amber-primary text-white text-xs font-bold uppercase tracking-wider px-4 py-2 rounded">
        Available 24/7 for Emergency Lockouts & Initial Securing
      </div>
    </div>

  </div>
</section>
