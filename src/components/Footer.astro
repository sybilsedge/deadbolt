---
import { siteConfig } from '../config/site';
---

<footer class="bg-black text-gray-400 py-8 text-center text-xs border-t border-gray-800">
  <p class="mb-2">
    {siteConfig.name} &nbsp;|&nbsp; {siteConfig.location.full} &nbsp;|&nbsp; Phone: <a href={`tel:${siteConfig.contact.phoneRaw}`} class="hover:text-amber-primary transition">{siteConfig.contact.phone}</a> &nbsp;|&nbsp; Email: <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-amber-primary transition">{siteConfig.contact.email}</a>
  </p>
  <p>&copy; <span id="footer-year">{new Date().getFullYear()}</span> {siteConfig.name}. All Rights Reserved. Property Preservation &amp; Field Services.</p>
</footer>

<script>
  const yearEl = document.getElementById('footer-year');
  if (yearEl) {
    yearEl.textContent = new Date().getFullYear().toString();
  }
</script>
