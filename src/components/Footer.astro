---
import { siteConfig } from '../config/site';
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Contact Strip & Brand Summary -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-slate-800/80">
      
      <!-- Brand & Tagline Column -->
      <div class="md:col-span-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-md">
              <svg class="w-5 h-5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
            </div>
            <span class="font-heading font-extrabold text-2xl tracking-tight text-white">
              {siteConfig.name}
            </span>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed max-w-md mb-6">
            {siteConfig.tagline}
          </p>
        </div>

        <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold px-3 py-1.5 rounded-full w-fit">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
          </svg>
          {siteConfig.badgeText}
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="md:col-span-3">
        <h4 class="font-heading font-bold text-sm uppercase tracking-wider text-white mb-4">
          Quick Links
        </h4>
        <ul class="space-y-2.5 text-sm">
          {siteConfig.navItems.map((item) => (
            <li>
              <a href={item.href} class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
                <span class="text-amber-500 text-xs">›</span>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info Strip (Windsor, Phone, Email) -->
      <div class="md:col-span-4">
        <h4 class="font-heading font-bold text-sm uppercase tracking-wider text-white mb-4">
          Contact Information
        </h4>
        <div class="space-y-3.5 text-sm">
          
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-amber-500 shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase tracking-wider font-semibold text-slate-500">Service Location</div>
              <div class="text-slate-200 font-medium">{siteConfig.location.full}</div>
              <div class="text-xs text-slate-400">Serving all Hampton Roads property managers</div>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-amber-500 shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase tracking-wider font-semibold text-slate-500">Phone Support</div>
              <a href={`tel:${siteConfig.contact.phoneRaw}`} class="text-slate-200 hover:text-amber-400 font-medium transition-colors">
                {siteConfig.contact.phone}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-amber-500 shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase tracking-wider font-semibold text-slate-500">Email Inquiry</div>
              <a href={`mailto:${siteConfig.contact.email}`} class="text-slate-200 hover:text-amber-400 font-medium transition-colors">
                {siteConfig.contact.email}
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Dynamic Copyright Line -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p id="copyright-text">
        © <span id="current-year">{new Date().getFullYear()}</span> {siteConfig.name}. All rights reserved.
      </p>
      <p class="text-slate-400">
        Designed for Hampton Roads Property Managers & Investors.
      </p>
    </div>

  </div>
</footer>

<script>
  // Ensure client-side dynamic year update if cached or static hydration
  const yearEl = document.getElementById('current-year');
  if (yearEl) {
    yearEl.textContent = new Date().getFullYear().toString();
  }
</script>
