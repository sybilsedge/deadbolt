---
import { siteConfig } from '../config/site';
---

<header class="sticky top-0 z-50 w-full shadow-lg transition-all duration-300">
  <!-- Top Utility Bar with Contact Info & Veteran Badge -->
  <div class="bg-slate-950 text-slate-300 border-b border-amber-500/20 text-xs py-2 px-4">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
      <!-- Contact Strip -->
      <div class="flex items-center gap-4 text-slate-300">
        <a href={`tel:${siteConfig.contact.phoneRaw}`} class="flex items-center gap-1.5 hover:text-amber-400 transition-colors">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="font-medium">{siteConfig.contact.phone}</span>
        </a>
        <span class="hidden sm:inline text-slate-700">|</span>
        <a href={`mailto:${siteConfig.contact.email}`} class="hidden sm:flex items-center gap-1.5 hover:text-amber-400 transition-colors">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>{siteConfig.contact.email}</span>
        </a>
        <span class="hidden md:inline text-slate-700">|</span>
        <span class="hidden md:flex items-center gap-1.5 text-slate-400">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>{siteConfig.location.full}</span>
        </span>
      </div>

      <!-- Top-right Veteran Badge -->
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 bg-amber-500/10 text-amber-400 border border-amber-500/30 font-semibold px-2.5 py-0.5 rounded-full text-[11px] uppercase tracking-wider shadow-sm">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
          </svg>
          {siteConfig.badgeText}
        </span>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <nav class="glass-nav border-b border-slate-800 text-white px-4 py-3">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Brand Logo / Header Area with Key & Home Motif -->
      <a href="#home" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
          <!-- House & Key Motif SVG -->
          <svg class="w-6 h-6 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-extrabold text-xl tracking-tight text-white group-hover:text-amber-400 transition-colors">
            {siteConfig.name}
          </span>
          <span class="text-[10px] uppercase tracking-widest text-slate-400 font-medium">
            Property Turnover & Make-Ready
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-8 text-sm font-medium">
        {siteConfig.navItems.map((item) => (
          <a
            href={item.href}
            class={`transition-colors py-1 relative hover:text-amber-400 ${
              item.name === 'Get a Quote' 
                ? 'bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-4 py-2 rounded-lg shadow-md hover:shadow-amber-500/20 transform hover:-translate-y-0.5 transition-all'
                : 'text-slate-300 hover:text-amber-400'
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-btn"
        type="button" 
        class="md:hidden text-slate-300 hover:text-amber-400 focus:outline-none p-2 rounded-md hover:bg-slate-800"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="menu-icon-open">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="menu-icon-close">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden md:hidden pt-4 pb-2 border-t border-slate-800 mt-3 px-2">
      <div class="flex flex-col gap-3">
        {siteConfig.navItems.map((item) => (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-md text-base font-medium transition-colors ${
              item.name === 'Get a Quote'
                ? 'bg-amber-500 text-slate-950 font-bold text-center mt-2'
                : 'text-slate-200 hover:bg-slate-800 hover:text-amber-400'
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile Menu Toggle Script
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (menuBtn && mobileMenu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });

    // Close mobile menu when clicking any nav link
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
