---
import { siteConfig } from '../config/site';
---

<header class="bg-brand-dark text-white sticky top-0 z-50 shadow-md">
  <!-- TOP ANNOUNCEMENT STRIP -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex justify-between items-center text-xs sm:text-sm font-medium border-b border-slate-800">
    <div class="flex items-center space-x-4 sm:space-x-6">
      <span>📍 {siteConfig.location.full}</span>
      <span class="hidden md:inline">📞 <a href={`tel:${siteConfig.contact.phoneRaw}`} class="hover:text-amber-primary transition">{siteConfig.contact.phone}</a></span>
    </div>
    <div class="bg-amber-primary text-white px-3 py-1 rounded font-bold uppercase tracking-wider text-xs">
      {siteConfig.badgeText}
    </div>
  </div>

  <!-- MAIN NAV -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
    <!-- Logo -->
    <a href="#home" class="flex items-center space-x-3 group">
      <div class="p-2.5 bg-slate-800 rounded-lg border border-amber-primary/40 group-hover:border-amber-primary transition">
        <svg class="w-7 h-7 text-amber-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <!-- Padlock / Deadbolt icon -->
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
      </div>
      <div>
        <span class="text-2xl font-black tracking-wider block leading-none text-white uppercase">
          DEAD BOLT<span class="text-amber-primary">, INC.</span>
        </span>
        <span class="text-xs tracking-widest text-gray-400 font-bold uppercase">
          PROPERTY PRESERVATION &amp; REO SERVICES
        </span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="flex items-center space-x-6 text-sm font-semibold tracking-wide">
      {siteConfig.navItems.map((item) => (
        <a
          href={item.href}
          class={
            item.name === 'REQUEST WORK ORDER'
              ? 'bg-amber-primary hover:bg-amber-hover text-white px-4 py-2 rounded font-bold transition shadow-sm'
              : item.name === 'HOME'
              ? 'text-amber-primary hover:text-white transition'
              : 'hover:text-amber-primary transition text-white'
          }
        >
          {item.name}
        </a>
      ))}
    </nav>
  </div>
</header>
