---
import { siteConfig } from '../config/site';
---

<section id="quote" class="bg-brand-dark text-white py-16 border-t border-gray-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-black uppercase tracking-tight text-white">SUBMIT A WORK ORDER REQUEST</h2>
      <p class="text-gray-400 mt-2">Need a property secured, cleaned out, or inspected? Send details for a rapid estimate.</p>
    </div>

    <form id="work-order-form" class="bg-slate-800 p-8 rounded-lg border border-gray-700 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold uppercase text-gray-300 mb-2">Client / Company Name</label>
          <input 
            type="text" 
            name="clientName"
            required
            class="w-full bg-slate-900 border border-gray-700 rounded px-4 py-3 text-white focus:outline-none focus:border-amber-primary" 
            placeholder="Asset Mgmt / Realty / Bank" 
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-gray-300 mb-2">Contact Phone</label>
          <input 
            type="tel" 
            name="phone"
            required
            class="w-full bg-slate-900 border border-gray-700 rounded px-4 py-3 text-white focus:outline-none focus:border-amber-primary" 
            placeholder="(757) 555-0000" 
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase text-gray-300 mb-2">Property Address</label>
        <input 
          type="text" 
          name="address"
          required
          class="w-full bg-slate-900 border border-gray-700 rounded px-4 py-3 text-white focus:outline-none focus:border-amber-primary" 
          placeholder="Street Address, City, State, Zip" 
        />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase text-gray-300 mb-2">Services Needed</label>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 text-sm text-gray-300">
          <label class="flex items-center space-x-2">
            <input type="checkbox" name="services" value="rekey" class="accent-amber-primary" />
            <span>Initial Rekey / Secure</span>
          </label>
          <label class="flex items-center space-x-2">
            <input type="checkbox" name="services" value="trashout" class="accent-amber-primary" />
            <span>Trash-Out / Debris</span>
          </label>
          <label class="flex items-center space-x-2">
            <input type="checkbox" name="services" value="yard" class="accent-amber-primary" />
            <span>Lawn / Yard Care</span>
          </label>
          <label class="flex items-center space-x-2">
            <input type="checkbox" name="services" value="eviction" class="accent-amber-primary" />
            <span>Eviction Crew</span>
          </label>
          <label class="flex items-center space-x-2">
            <input type="checkbox" name="services" value="winterization" class="accent-amber-primary" />
            <span>Winterization</span>
          </label>
          <label class="flex items-center space-x-2">
            <input type="checkbox" name="services" value="cleaning" class="accent-amber-primary" />
            <span>Deep Clean / Maid</span>
          </label>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase text-gray-300 mb-2">Work Order Details / Notes</label>
        <textarea 
          name="notes"
          rows="4" 
          class="w-full bg-slate-900 border border-gray-700 rounded px-4 py-3 text-white focus:outline-none focus:border-amber-primary" 
          placeholder="Specific lock requirements, deadline, code violation notices, etc."
        ></textarea>
      </div>

      <button 
        type="submit" 
        class="w-full bg-amber-primary hover:bg-amber-hover text-white font-extrabold py-4 rounded text-lg uppercase tracking-wider transition cursor-pointer"
      >
        SUBMIT WORK ORDER REQUEST
      </button>

      <!-- Success Message Toast -->
      <div id="form-success" class="hidden bg-amber-primary/20 border border-amber-primary text-amber-primary p-4 rounded text-center text-sm font-bold uppercase tracking-wider">
        ✓ Work Order Request Received! Our dispatch team will contact you within 24 hours.
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('work-order-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');

  if (form && successMsg) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successMsg.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        successMsg.classList.add('hidden');
      }, 6000);
    });
  }
</script>
