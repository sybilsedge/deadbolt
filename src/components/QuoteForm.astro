---
import { siteConfig } from '../config/site';
---

<section id="quote" class="py-24 bg-slate-950 text-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto bg-slate-900 border border-slate-800 rounded-3xl p-8 sm:p-12 shadow-2xl relative overflow-hidden">
      <!-- Glow Accent -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="text-center mb-10">
        <span class="inline-block bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-3">
          Fast Estimate
        </span>
        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl text-white tracking-tight mb-3">
          Request Your Turnover Quote
        </h2>
        <p class="text-slate-400 text-sm sm:text-base">
          Fill out unit details below to receive a guaranteed turnover estimate within 24 hours.
        </p>
      </div>

      <form id="turnover-quote-form" class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="fullName" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Full Name *</label>
            <input 
              type="text" 
              id="fullName" 
              name="fullName" 
              required 
              placeholder="Jane Doe"
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors"
            />
          </div>

          <div>
            <label for="company" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Property Mgmt Company</label>
            <input 
              type="text" 
              id="company" 
              name="company" 
              placeholder="Coastal Property Management"
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Phone Number *</label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              required 
              placeholder="(757) 555-0199"
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Email Address *</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="jane@coastalpm.com"
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <label for="serviceType" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Service Needed</label>
            <select 
              id="serviceType" 
              name="serviceType" 
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
            >
              <option value="full-bundle">Full Turnover Bundle (Paint, Clean, Repair)</option>
              <option value="paint-patch">Paint & Patch Only</option>
              <option value="deep-clean">Deep Turnover Clean Only</option>
              <option value="minor-repairs">Minor Repairs & Maintenance</option>
            </select>
          </div>

          <div>
            <label for="unitCount" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Unit Type / Count</label>
            <input 
              type="text" 
              id="unitCount" 
              name="unitCount" 
              placeholder="2 Bed / 2 Bath (1 Unit)"
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors"
            />
          </div>

          <div>
            <label for="targetDate" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Target Ready Date</label>
            <input 
              type="date" 
              id="targetDate" 
              name="targetDate" 
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
            />
          </div>
        </div>

        <div>
          <label for="notes" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">Property Address / Special Notes</label>
          <textarea 
            id="notes" 
            name="notes" 
            rows="3" 
            placeholder="Property location in Hampton Roads, specific wall repairs needed, appliance cleaning details, key access instructions..."
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors resize-none"
          ></textarea>
        </div>

        <div class="text-center pt-2">
          <button 
            type="submit" 
            class="w-full sm:w-auto gold-gradient-bg text-slate-950 font-bold text-base px-10 py-4 rounded-xl shadow-xl hover:shadow-amber-500/25 transition-all transform hover:-translate-y-0.5 uppercase tracking-wider inline-flex items-center justify-center gap-2"
          >
            <span>SUBMIT QUOTE REQUEST</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </div>

        <!-- Success Toast Notification -->
        <div id="form-success" class="hidden bg-amber-500/10 border border-amber-500 text-amber-400 p-4 rounded-xl text-center text-sm font-medium">
          ✓ Quote request received! Our project manager will contact you within 24 hours.
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('turnover-quote-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');

  if (form && successMsg) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successMsg.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        successMsg.classList.add('hidden');
      }, 6000);
    });
  }
</script>
