---
import { siteConfig } from '../config/site';
import ServiceCard from './ServiceCard.astro';
---

<section id="services" class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-4xl font-black text-brand-dark uppercase tracking-tight">
      FULL-SERVICE PROPERTY PRESERVATION
    </h2>
    <p class="text-gray-600 mt-2 max-w-2xl mx-auto">
      From initial lockout to market-ready condition, we handle all field service requirements quickly and compliant with local codes.
    </p>
    <div class="w-20 h-1.5 bg-amber-primary mx-auto mt-4"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {siteConfig.services.map((service) => (
      <ServiceCard service={service} />
    ))}
  </div>
</section>
