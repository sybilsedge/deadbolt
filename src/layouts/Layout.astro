---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `${siteConfig.name} | Property Preservation & REO Services`,
  description = siteConfig.tagline
} = Astro.props;
---

<!usr/bin/env html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="keywords" content="Dead Bolt Inc, property preservation, REO trash-outs, lockouts, rekeying, eviction cleanouts, yard abatement, winterization, Hampton Roads, Virginia Beach" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans antialiased selection:bg-orange-600 selection:text-white">
    <slot />
  </body>
</html>
