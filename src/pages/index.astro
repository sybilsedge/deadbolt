---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Advantage from '../components/Advantage.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
---

<Layout 
  title={`${siteConfig.name} | Hampton Roads Property Turnover & Make-Ready`}
  description={siteConfig.tagline}
>
  <!-- Announcement / Top Navigation -->
  <Navbar />

  <main>
    <!-- Hero Section -->
    <Hero />

    <!-- Core Services Grid -->
    <Services />

    <!-- Turnkey Advantage & Leadership Section -->
    <Advantage />

    <!-- Interactive Quote Request Section -->
    <QuoteForm />
  </main>

  <!-- Dark Navy Footer -->
  <Footer />
</Layout>
