---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Advantage from '../components/Advantage.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
---

<Layout 
  title={`${siteConfig.name} | Property Preservation & REO Services`}
  description={siteConfig.tagline}
>
  <!-- TOP ANNOUNCEMENT & NAVIGATION -->
  <Navbar />

  <main>
    <!-- HERO SECTION & TRUST SPECS BAR -->
    <Hero />

    <!-- FULL-SERVICE PROPERTY PRESERVATION GRID -->
    <Services />

    <!-- WHY US & REGIONAL COVERAGE SECTION -->
    <Advantage />

    <!-- WORK ORDER REQUEST FORM -->
    <QuoteForm />
  </main>

  <!-- FOOTER -->
  <Footer />
</Layout>
